builddir = out
commonflags = -O2 -Wall -Wextra -Iprotocol $$(pkg-config --cflags wayland-client wayland-cursor xkbcommon cairo)
cflags = $commonflags
cppflags = -std=c++17 $commonflags
ldflags = $$(pkg-config --libs wayland-client wayland-cursor xkbcommon cairo)

rule cc
  command = cc -MMD -MF $out.d $cflags -c $in -o $out
  depfile = $out.d
  deps = gcc

rule cxx
  command = c++ -MMD -MF $out.d $cppflags -c $in -o $out
  depfile = $out.d
  deps = gcc

rule link
  command = c++ $in -o $out $ldflags

rule install
  command = cp cullpp /usr/local/bin/

build $builddir/main.o: cxx main.cpp
build $builddir/shm_pool.o: cxx shm_pool.cpp

build $builddir/wlr-layer-shell-unstable-v1-protocol.o: cc protocol/wlr-layer-shell-unstable-v1-protocol.c
build $builddir/xdg-output-unstable-v1-protocol.o: cc protocol/xdg-output-unstable-v1-protocol.c
build $builddir/cursor-shape-v1-protocol.o: cc protocol/cursor-shape-v1-protocol.c
build $builddir/xdg-shell-protocol.o: cc protocol/xdg-shell-protocol.c
build $builddir/tablet-unstable-v2-protocol.o: cc protocol/tablet-unstable-v2-protocol.c

build cullpp: link $
  $builddir/main.o $
  $builddir/shm_pool.o $
  $builddir/wlr-layer-shell-unstable-v1-protocol.o $
  $builddir/xdg-output-unstable-v1-protocol.o $
  $builddir/cursor-shape-v1-protocol.o $
  $builddir/xdg-shell-protocol.o $
  $builddir/tablet-unstable-v2-protocol.o

default cullpp

build install: install cullpp
