builddir = out
version = 1.0.0-rc.2
commonflags = -O2 -Wall -Wextra -I$builddir/protocol -Iprotocol $$(pkg-config --cflags wayland-client wayland-cursor xkbcommon cairo)
cflags = $commonflags
cppflags = -std=c++17 -DCULLPP_VERSION=\"$version\" $commonflags
ldflags = $$(pkg-config --libs wayland-client wayland-cursor xkbcommon cairo)

rule scanner_header
  command = sh -c 'mkdir -p "$$(dirname "$$2")" && wayland-scanner client-header "$$1" "$$2"' sh $in $out

rule scanner_code
  command = sh -c 'mkdir -p "$$(dirname "$$2")" && wayland-scanner private-code "$$1" "$$2"' sh $in $out

rule cc
  command = cc -MMD -MF $out.d $cflags -c $in -o $out
  depfile = $out.d
  deps = gcc

rule cxx
  command = c++ -MMD -MF $out.d $cppflags -c $in -o $out
  depfile = $out.d
  deps = gcc

rule link
  command = c++ $in -o $out $ldflags

rule install
  command = cp cullpp /usr/local/bin/

build $builddir/protocol/wlr-layer-shell-unstable-v1-client-protocol.h: scanner_header protocol/wlr-layer-shell-unstable-v1.xml
build $builddir/protocol/wlr-layer-shell-unstable-v1-protocol.c: scanner_code protocol/wlr-layer-shell-unstable-v1.xml
build $builddir/protocol/xdg-output-unstable-v1-client-protocol.h: scanner_header protocol/xdg-output-unstable-v1.xml
build $builddir/protocol/xdg-output-unstable-v1-protocol.c: scanner_code protocol/xdg-output-unstable-v1.xml
build $builddir/protocol/cursor-shape-v1-client-protocol.h: scanner_header protocol/cursor-shape-v1.xml
build $builddir/protocol/cursor-shape-v1-protocol.c: scanner_code protocol/cursor-shape-v1.xml
build $builddir/protocol/xdg-shell-client-protocol.h: scanner_header protocol/xdg-shell.xml
build $builddir/protocol/xdg-shell-protocol.c: scanner_code protocol/xdg-shell.xml
build $builddir/protocol/tablet-unstable-v2-client-protocol.h: scanner_header protocol/tablet-unstable-v2.xml
build $builddir/protocol/tablet-unstable-v2-protocol.c: scanner_code protocol/tablet-unstable-v2.xml

build $builddir/main.o: cxx main.cpp || $
  $builddir/protocol/wlr-layer-shell-unstable-v1-client-protocol.h $
  $builddir/protocol/xdg-output-unstable-v1-client-protocol.h $
  $builddir/protocol/cursor-shape-v1-client-protocol.h
build $builddir/shm-pool.o: cxx shm-pool.cpp

build $builddir/wlr-layer-shell-unstable-v1-protocol.o: cc $builddir/protocol/wlr-layer-shell-unstable-v1-protocol.c
build $builddir/xdg-output-unstable-v1-protocol.o: cc $builddir/protocol/xdg-output-unstable-v1-protocol.c
build $builddir/cursor-shape-v1-protocol.o: cc $builddir/protocol/cursor-shape-v1-protocol.c
build $builddir/xdg-shell-protocol.o: cc $builddir/protocol/xdg-shell-protocol.c
build $builddir/tablet-unstable-v2-protocol.o: cc $builddir/protocol/tablet-unstable-v2-protocol.c

build cullpp: link $
  $builddir/main.o $
  $builddir/shm-pool.o $
  $builddir/wlr-layer-shell-unstable-v1-protocol.o $
  $builddir/xdg-output-unstable-v1-protocol.o $
  $builddir/cursor-shape-v1-protocol.o $
  $builddir/xdg-shell-protocol.o $
  $builddir/tablet-unstable-v2-protocol.o

default cullpp

build install: install cullpp
